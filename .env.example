# Copy to .env if you want to override defaults (optional - the app works
# with zero configuration out of the box).

# "local" (default) = registry is a bundled SQLite file, read directly by this
#         app - no second service needed. This is what Docker/Render use.
# "http"  = talk to a separately-run registry_service (only if you deliberately
#         split it out into its own host - see README "Known limitations").
DOCUSHIELD_REGISTRY_MODE=local

# Only relevant when DOCUSHIELD_REGISTRY_MODE=http:
# DOCUSHIELD_REGISTRY_URL=http://127.0.0.1:8001
# DOCUSHIELD_REGISTRY_KEY=demo-checkpoint-key

DOCUSHIELD_FACE_BACKEND=auto        # auto | deepface | demo
DOCUSHIELD_LEDGER=data/audit_ledger.jsonl
DOCUSHIELD_LEDGER_SALT=change-me-in-deployment
